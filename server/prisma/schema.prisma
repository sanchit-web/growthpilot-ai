generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model GrowthAction {
  id               String  @id
  actionType       String
  title            String
  description      String
  targetProduct    String?
  suggestedProduct String?
  status           String
  requiresApproval Boolean
  executionResult  Json?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(uuid())

  growthActionId String
  growthAction   GrowthAction @relation(fields: [growthActionId], references: [id], onDelete: Cascade)

  razorpayPaymentId     String? @unique
  razorpayOrderId       String?
  razorpayPaymentLinkId String?

  amount   Int
  currency String

  status PaymentStatus

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([growthActionId])
  @@index([razorpayPaymentLinkId])
}
